.env

# dados brutos do FIRMS (pesados demais pro GitHub)
*.csv
# ...mas os CSVs do contrato de dados (deriva.csv, validacao.csv) vão para o Git
!saida/*.csv

# pastas de download do FIRMS (só teriam o Readme.txt sem os CSVs)
data/raw/nasa/*
!data/raw/nasa/.gitkeep

.claude
PLANO.md
PLANO_DIVIDIDO.md
PLANO2.md
# arquivos gerados: saida/ VAI para o Git (a equipe usa direto);
# só os intermediários, recriados pelo pipeline, ficam de fora
saida/_tmp/
.venv/
__pycache__/
